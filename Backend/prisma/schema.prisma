generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FREELANCER
  CLIENT
}

enum Status {
  PENDING
  APPROVED
  DECLINED
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  passwordHash     String
  fullName         String
  role             Role            @default(FREELANCER)
  phoneNumber      String?
  createdAt        DateTime        @default(now())
  
  projects         Project[]
  changeRequests   ChangeRequest[]
  auditLogs        AuditLog[]
}

model Project {
  id               String          @id @default(uuid())
  freelancerId     String
  title            String
  description      String?
  clientName       String
  clientEmail      String
  clientPhone      String?
  status           String          @default("active")
  createdAt        DateTime        @default(now())
  
  freelancer       User            @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  scopes           Scope[]
  changeRequests   ChangeRequest[]
  invoices         Invoice[]
}

model Scope {
  id               String          @id @default(uuid())
  projectId        String
  shareToken       String          @unique
  isPublic         Boolean         @default(true)
  totalAmount      Int             @default(0) // Stored in paise
  status           String          @default("draft")
  createdAt        DateTime        @default(now())
  
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverables     Deliverable[]
}

model Deliverable {
  id               String          @id @default(uuid())
  scopeId          String
  name             String
  description      String?
  qty              Int             @default(1)
  unitPrice        Int             // Stored in paise
  includedRevisions Int            @default(0)
  usedRevisions    Int             @default(0)
  
  scope            Scope           @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  changeRequests   ChangeRequest[]
}

model ChangeRequest {
  id               String          @id @default(uuid())
  projectId        String
  deliverableId    String?
  title            String
  description      String?
  priceImpact      Int             @default(0) // Stored in paise
  daysImpact       Int             @default(0)
  status           Status          @default(PENDING)
  createdById      String?
  approverName     String?
  approverEmail    String?
  approvedAt       DateTime?
  declineReason    String?
  createdAt        DateTime        @default(now())
  
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverable      Deliverable?    @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  createdBy        User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
}

model Invoice {
  id                     String        @id @default(uuid())
  projectId              String
  invoiceNumber          String        @unique
  amount                 Int           // Stored in paise
  status                 InvoiceStatus @default(UNPAID)
  razorpayPaymentLinkId  String?
  razorpayPaymentLinkUrl String?
  pdfUrl                 String?
  paidAt                 DateTime?
  createdAt              DateTime      @default(now())
  
  project                Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id               String          @id @default(uuid())
  entityType       String          // 'project', 'scope', 'change_request', 'invoice'
  entityId         String
  action           String          // 'created', 'updated', 'approved', 'deleted'
  actorId          String?
  changes          Json?
  createdAt        DateTime        @default(now())
  
  actor            User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
}
